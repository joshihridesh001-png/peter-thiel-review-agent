[Unit]
Description=Run the Peter Thiel backup every night at 23:30 IST

[Timer]
# After the 8:00 PM card, 9:00 PM goals and 9:30 PM nudge.
OnCalendar=*-*-* 23:30:00 Asia/Kolkata
# If the server was off at 23:30, run as soon as it is back.
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
